<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ibtissam_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ibtissam_background"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/ibtissam_layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/ibtissam_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Système de Localisation Connecté"
            android:textColor="@color/ibtissam_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ibtissam_card_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/ibtissam_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/ibtissam_primary"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toBottomOf="@id/ibtissam_layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛰️"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Statut GPS &amp; Coordonnées"
                    android:textColor="@color/ibtissam_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/ibtissam_primary"
                android:alpha="0.4" />

            <TextView
                android:id="@+id/ibtissam_tv_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ibtissam_no_location"
                android:textColor="@color/ibtissam_text"
                android:lineSpacingExtra="6dp"
                android:textSize="16sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Send Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/ibtissam_btn_send"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/ibtissam_btn_send"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/ibtissam_primary"
        app:layout_constraintTop_toBottomOf="@id/ibtissam_card_info" />

    <!-- Clear Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/ibtissam_btn_clear"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="@string/ibtissam_btn_clear"
        android:textColor="@color/ibtissam_error"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/ibtissam_error"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toBottomOf="@id/ibtissam_btn_send" />

    <!-- Footer -->
    <TextView
        android:id="@+id/ibtissam_tv_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/ibtissam_footer"
        android:textColor="@color/ibtissam_text_muted"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>